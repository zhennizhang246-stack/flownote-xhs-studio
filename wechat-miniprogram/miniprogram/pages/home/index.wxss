.upload{min-height:190rpx;border:2rpx dashed #aaa89f;border-radius:22rpx;background:#f4f1e9;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#536c5e;font-size:23rpx}.upload-plus{width:72rpx;height:72rpx;margin-bottom:14rpx;border-radius:50%;background:#18211d;color:#fff;font-size:48rpx;line-height:68rpx;text-align:center}.image-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10rpx;margin-top:20rpx}.image-wrap{position:relative;aspect-ratio:3/4}.image-wrap image{width:100%;height:100%;border-radius:12rpx}.remove{position:absolute;right:-7rpx;top:-9rpx;width:38rpx;height:38rpx;padding:0;border:2rpx solid #fff;border-radius:50%;background:#9a5f42;color:#fff;font-size:28rpx;line-height:34rpx}.cover{position:relative;aspect-ratio:3/4;overflow:hidden;border-radius:24rpx;background:linear-gradient(135deg,#8a987f,#3f5245)}.cover image,.cover-shade{position:absolute;inset:0;width:100%;height:100%}.cover-shade{background:linear-gradient(180deg,rgba(18,23,19,.05),rgba(18,23,19,.82))}.cover-copy{position:absolute;left:42rpx;right:42rpx;bottom:54rpx;color:#fff}.cover-title,.cover-subtitle{display:block}.cover-title{font-family:Georgia,"Songti SC",serif;font-size:64rpx;line-height:1.18}.cover-subtitle{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid rgba(255,255,255,.5);font-size:21rpx}.draft-text{padding:20rpx;border-radius:18rpx;background:#f4f1e9;line-height:1.75;white-space:pre-wrap}.title-text{font-size:32rpx;font-weight:600}.body-text{font-size:25rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}.tags text{padding:8rpx 13rpx;border-radius:99rpx;background:#ece8de;color:#68716a;font-size:20rpx}
