.project-card{margin-top:24rpx;overflow:hidden;border:1rpx solid #d9d6cd;border-radius:26rpx;background:#faf9f5}.project-card>image{width:100%;height:360rpx}.project-body{padding:24rpx}.project-top{display:flex;align-items:center;justify-content:space-between}.state{color:#536c5e;font-size:20rpx}.project-name{margin-top:20rpx;font-family:Georgia,"Songti SC",serif;font-size:40rpx}.project-title{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #e0ddd5;font-size:26rpx;line-height:1.6}.project-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:22rpx}.mini{height:78rpx;border:0;border-radius:16rpx;background:#536c5e;color:#fff;font-size:23rpx;line-height:78rpx}.mini::after{border:0}.mini.light{background:#ece8de;color:#18211d}
