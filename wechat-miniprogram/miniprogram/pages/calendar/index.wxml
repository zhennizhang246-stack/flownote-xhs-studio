<view class="page"><text class="kicker">PUBLISHING CALENDAR</text><view class="page-title">发布日历</view><view class="subtle">默认每三天安排一篇，正式发布前保留人工确认。</view>
  <view class="card"><view class="section-title"><text>自动工作节奏</text><text class="pill">Asia/Shanghai</text></view><view class="grid-two"><view class="field"><text class="field-label">发布时间</text><picker mode="time" value="{{settings.publishTime}}" bindchange="changeTime"><view class="picker">{{settings.publishTime}}</view></picker></view><view class="field"><text class="field-label">研究时间</text><picker mode="time" value="{{settings.researchTime}}" bindchange="changeResearchTime"><view class="picker">{{settings.researchTime}}</view></picker></view></view><view class="field"><text class="field-label">发布间隔（天）</text><input class="input" type="number" value="{{settings.publishCadenceDays}}" bindinput="changeCadence" /></view><button class="button secondary" loading="{{saving}}" bindtap="save">保存排期设置</button></view>
  <view class="card"><view class="section-title"><text>待发布队列</text><text class="pill">{{projects.length}} 项</text></view><view class="empty" wx:if="{{!projects.length}}"><text class="empty-title">队列为空</text><text class="empty-desc">在资产库人工确认项目后，项目会进入这里。</text></view><view class="queue" wx:for="{{projects}}" wx:key="_id"><view><text class="queue-name">{{item.name}}</text><text class="queue-meta">{{item.location}} · {{item.area}}</text></view><text class="pill">{{item.status}}</text></view></view>
</view>
