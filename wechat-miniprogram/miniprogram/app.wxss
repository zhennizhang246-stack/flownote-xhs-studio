page{background:#f0eee7;color:#18211d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}.page{min-height:100vh;padding:32rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));box-sizing:border-box}.kicker{color:#9a5f42;font-family:Georgia,serif;font-size:18rpx;letter-spacing:4rpx}.page-title{margin:10rpx 0 8rpx;font-family:Georgia,"Songti SC",serif;font-size:52rpx;font-weight:400}.subtle{color:#788078;font-size:22rpx;line-height:1.7}.card{margin-top:24rpx;padding:28rpx;background:#faf9f5;border:1rpx solid #d9d6cd;border-radius:28rpx;box-sizing:border-box}.section-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.section-title text:first-child{font-size:30rpx;font-weight:600}.pill{padding:8rpx 15rpx;border-radius:99rpx;background:#ece8de;color:#68716a;font-size:19rpx}.field{margin-top:20rpx}.field-label{display:block;margin-bottom:10rpx;color:#788078;font-size:21rpx}.input,.textarea,.picker{width:100%;min-height:88rpx;padding:20rpx 22rpx;border:1rpx solid #d9d6cd;border-radius:18rpx;background:#fff;box-sizing:border-box;font-size:28rpx}.textarea{min-height:160rpx}.button{min-height:92rpx;margin-top:22rpx;border:0;border-radius:20rpx;background:#18211d;color:#fff;font-size:28rpx;line-height:92rpx}.button::after{border:0}.button.secondary{background:#536c5e}.button.light{background:#ece8de;color:#18211d}.button.danger{background:#a5544b}.button[disabled]{opacity:.48}.empty{padding:70rpx 20rpx;text-align:center;color:#788078}.empty-title{display:block;color:#18211d;font-size:28rpx;font-weight:600}.empty-desc{display:block;margin-top:12rpx;font-size:22rpx;line-height:1.7}.grid-two{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.safe-note{margin-top:18rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#e7eee8;color:#466150;font-size:21rpx;line-height:1.6}
