DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3-vl-plus
# Optional. The default is the public Beijing endpoint below.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional OpenAI-compatible fallback. Models are tried from left to right
# after the Qwen models. Never expose these values in browser-side code.
XHS_AI_API_KEY=
XHS_AI_BASE_URL=
XHS_AI_MODELS=
PRIMARY_OWNER_EMAIL=

# Only fill these after Xiaohongshu approves the account/app for a formal
# content-publishing interface. The endpoint must be HTTPS on xiaohongshu.com.
XHS_OFFICIAL_PUBLISH_ENDPOINT=
XHS_OFFICIAL_PUBLISH_TOKEN=
XHS_OFFICIAL_ACCOUNT_ID=
