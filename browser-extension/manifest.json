{
  "manifest_version": 3,
  "name": "MJ 小红书发布桥",
  "version": "2.2.0",
  "description": "同步同一小红书账号共享工作区的封面、正文、项目与发布排期。",
  "permissions": ["storage", "tabs", "alarms", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://xhs-studio-secretary.mj051225.chatgpt.site/*",
    "https://creator.xiaohongshu.com/*",
    "https://www.xiaohongshu.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "MJ 小红书发布桥",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xhs-studio-secretary.mj051225.chatgpt.site/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/publish/*"],
      "js": ["xhs-prefill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/search_result*",
        "https://www.xiaohongshu.com/explore/*",
        "https://www.xiaohongshu.com/discovery/item/*"
      ],
      "js": ["xhs-research.js"],
      "run_at": "document_idle"
    }
  ]
}
